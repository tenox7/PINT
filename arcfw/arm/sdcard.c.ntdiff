+typedef struct _SD_HOST {
+    PCHAR Name;
+    BOOLEAN (*Reset)(VOID);
+    BOOLEAN (*SetClock)(IN ULONG Hz);
+    BOOLEAN (*Command)(IN ULONG Command, IN ULONG Argument, IN ULONG Blocks);
+    ULONG (*Response)(IN ULONG Word);
+    BOOLEAN (*Transfer)(IN PULONG Buffer, IN ULONG Blocks, IN BOOLEAN Read);
+    VOID (*SetBusWidth)(IN ULONG Bits);
+} SD_HOST, *PSD_HOST;
