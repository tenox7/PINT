+//
+// Program the SD clock: the core clock divided by SDCDIV + 2, the largest
+// rate at or below Hz; and the timeout of a command or a block, half a second.
+//
+static BOOLEAN
+SdhostSetClock(
+    IN ULONG Hz
+    )
+{
+    ULONG divisor = SdBaseClock / Hz;
+
+    if (divisor < 2) {
+        divisor = 2;
+    }
+    if (SdBaseClock / divisor > Hz) {
+        divisor += 1;
+    }
+    divisor -= 2;
+    if (divisor > SDCDIV_MAX) {
+        divisor = SDCDIV_MAX;
+    }
+    REG(SDCDIV) = divisor;
+    REG(SDTOUT) = SdBaseClock / (divisor + 2) / 2;
