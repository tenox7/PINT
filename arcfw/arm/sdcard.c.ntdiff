+// Move Blocks 512-byte blocks through the FIFO, in bursts of up to 8 words as
+// its level allows; a written block is waited for until the card has taken it
+// (the block interrupt status), so that the CMD12 that ends a multiple block
+// transfer cannot cut the last one short. Then the transfer is ended with
+// CMD12 and the controller left to settle.
+//
+static BOOLEAN
+SdhostTransfer(
+    IN PULONG Buffer,
+    IN ULONG Blocks,
+    IN BOOLEAN Read
+    )
+{
+    ULONG start;
+    ULONG words;
+    ULONG level, n, burst;
+
+    REG(SDHSTS) = SDHSTS_BLOCK_IRPT;
+    while (Blocks--) {
+        words = SECTOR_SIZE / sizeof(ULONG);
+        start = FwGetMicroseconds();
+        while (words != 0) {
+            level = SDEDM_FIFO_LEVEL(REG(SDEDM));
+            n = Read ? level : SDHOST_FIFO_WORDS - level;
+            burst = words < SDHOST_PIO_BURST ? words : SDHOST_PIO_BURST;
+            if (n < burst) {
+                if ((REG(SDHSTS) & SDHSTS_ERRORS) != 0 || (FwGetMicroseconds() - start) > TIMEOUT_US) {
+                    SdhostAbort();
+                    return FALSE;
+                }
+                continue;
+            }
+            if (n > words) {
+                n = words;
+            }
+            words -= n;
+            while (n--) {
+                if (Read) {
+                    *Buffer++ = REG(SDDATA);
+                } else {
+                    REG(SDDATA) = *Buffer++;
+                }
+            }
+            start = FwGetMicroseconds();
+        }
+
+        if (!Read) {
+            if (!SdWait(SDHSTS, SDHSTS_BLOCK_IRPT | SDHSTS_ERRORS, SDHSTS_BLOCK_IRPT)) {
+                SdhostAbort();
+                return FALSE;
+            }
+            REG(SDHSTS) = SDHSTS_BLOCK_IRPT;
=1 938 3
+    if ((REG(SDHSTS) & SDHSTS_ERRORS) != 0) {
