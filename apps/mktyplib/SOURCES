# mktyplib.exe, the type library compiler of OLE Automation, from NT 4.0 (private\oleauto\
# src\mktyplib: the edit scripts here): NT 3.5 installs stdole32.tlb (bom.txt, "OLE TWO"),
# which mktyplib makes from stdole.odl (build/make-stdole.sh), but its tree has neither.
# Built as oleauto\build\mktyplib.mak links it for a WIN32 retail build (OBJS without
# tlviewer; the flags of its WIN32 rules), with the headers of NT 3.5's OLE Automation
# (ole2.h with oleauto.h; dispatch.h includes that): those of the oleaut32 it runs with.
# A console program with main and the static C run-time (libc.lib).

TARGETNAME=mktyplib
TARGETPATH=obj
TARGETTYPE=PROGRAM
UMTYPE=console

INCLUDES=.;$(BASEDIR)\public\sdk\inc;$(BASEDIR)\public\sdk\inc\crt

C_DEFINES=-DWIN32 -DFV_UNICODE_OLE=1 -D_NTWIN -D_WINDOWS

SOURCES=lexer.c      \
        intlstr.c    \
        mktyplib.c   \
        parser.c     \
        hout.c       \
        typout.cpp   \
        dimalloc.cxx \
        mktyplib.rc

TARGETLIBS=$(BASEDIR)\public\sdk\lib\*\user32.lib   \
           $(BASEDIR)\public\sdk\lib\*\comdlg32.lib \
           $(BASEDIR)\public\sdk\lib\*\oleaut32.lib \
           $(BASEDIR)\public\sdk\lib\*\ole32.lib    \
           $(BASEDIR)\public\sdk\lib\*\uuid.lib
