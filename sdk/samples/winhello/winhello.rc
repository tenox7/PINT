#include <windows.h>
#include "winhello.h"

IDM_WINHELLO MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&About...", IDM_ABOUT
        MENUITEM SEPARATOR
        MENUITEM "E&xit", IDM_EXIT
    END
END

IDD_ABOUT DIALOG 0, 0, 180, 62
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Hello"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Hello, a sample of the PINT 4.0 SDK.", -1, 10, 12, 160, 10
    DEFPUSHBUTTON   "OK", IDOK, 65, 38, 50, 14
END
