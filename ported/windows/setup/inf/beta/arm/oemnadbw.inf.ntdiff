#ntdiff private/windows/setup/inf/beta/mips/oemnadso.inf
#crlf
=1 1 2
+; OEMNADBW.INF
+;
+;       Raspberry Pi wireless driver SETUP INF file.
=1 6 43
+    "BCM2836-Internal Bus"
+    "BCM2837-Internal Bus"
+    "BCM2711-Internal Bus"
=1 50 11
+    BCMWLAN
=1 62 31
+ProductSoftwareName     = "Bcmwlan"
+ProductSoftwareImagePath = "\SystemRoot\System32\drivers\bcmwlan.sys"
+NetRuleSoftwareType     = "bcmwlanSys ndisDriver bcmwlanDriver"
=1 96 1
+NetRuleSoftwareBindForm = """BcmwlanSys"" yes no container"
+NetRuleSoftwareClass    = {"bcmwlanDriver basic"}
+NetRuleSoftwareBindable = {"bcmwlanDriver bcmwlanAdapter non exclusive 100"}
=1 100 3
+ProductHardwareName     = "Bcmwlan"
+NetRuleHardwareType     = "bcmwlan bcmwlanAdapter"
=1 105 1
+NetRuleHardwareClass    = {"bcmwlanAdapter basic"}
=1 107 168
+    Debug-Output "OEMNADBW.INF: STF_CWDIR is: "$(!STF_CWDIR)
+    Debug-Output "OEMNADBW.INF: STF_LANGUAGE is: "$(!STF_LANGUAGE)
=1 277 44
+            Debug-Output "Cannot configure the bcmwlan driver software."
=1 322 641
