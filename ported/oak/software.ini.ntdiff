#ntdiff public/oak/bin/software.ini ../nt35/PUBLIC/OAK/BIN/SOFTWARE.INI
#crlf
=1 1 1645
+#if defined(_RASPI_) || defined(PWSFTP)
+        //
+        // The FTP pages of Internet Service Manager (INETSTP: the AddOnServices of INetMgr).
+        //
+        INetMgr
+            Parameters
+                AddOnServices
+                    FTP = fscfg.dll
+#endif // defined(_RASPI_) || defined(PWSFTP)
=1 1645 5
+                //
+                // \Program Files and its Common Files, which the setup of NT 4.0 names here.
+                //
+                ProgramFilesDir = C:\Program Files
+                CommonFilesDir = C:\Program Files\Common Files
=1 1650 2
+#if defined(_RASPI_) || defined(PWSFTP)
+                    //
+                    // Internet Service Manager of Peer Web Services (Start, Run: inetmgr), which
+                    // manages the FTP service.
+                    //
+                    inetmgr.exe
+                        = REG_EXPAND_SZ %SystemRoot%\System32\inetsrv\inetmgr.exe
+                        Path = REG_EXPAND_SZ %SystemRoot%\System32\inetsrv
+#endif // defined(_RASPI_) || defined(PWSFTP)
=1 1652 3
+#if defined(PWSFTP) && !defined(_RASPI_)
+                    //
+                    // After NT's setup, at the first logon: the home directory of the FTP service,
+                    // which the system disk is built with, and the LSA secrets of the service,
+                    // which its first boot makes from REGISTRY.INI.
+                    //
+                    FtpRoot = cmd /c md C:\InetPub\ftproot
+                    FtpSecrets = cmd /c %SystemRoot%\System32\inetsrv\svcsetup FtpSvc /add
+#endif // defined(PWSFTP) && !defined(_RASPI_)
=1 1655 267
+#if defined(_RASPI_)
+                    //
+                    // The adapter the network setup installs (NTLANMAN.INF, the INF of the
+                    // adapter: AddHardwareComponent).
+                    //
+                    1
+                        ServiceName = Bcmeth1
+                        Manufacturer = Microsoft
+                        Title = [1] Raspberry Pi Ethernet Adapter
+                        Description = Raspberry Pi Ethernet Adapter
+                        ProductName = Bcmeth
+                        OperationsSupport = REG_DWORD 0x00000086
+                        NetRules
+                            InfName = OEMNADBC.INF
+                            type = bcmeth bcmethAdapter
+                            bindform = "Bcmeth1" yes yes container
+                            class = REG_MULTI_SZ "bcmethAdapter basic"
+                            InfOption = BCMETH
+                    2
+                        ServiceName = Bcmwlan1
+                        Manufacturer = Microsoft
+                        Title = [2] Raspberry Pi Wireless Adapter
+                        Description = Raspberry Pi Wireless Adapter
+                        ProductName = Bcmwlan
+                        OperationsSupport = REG_DWORD 0x00000086
+                        NetRules
+                            InfName = OEMNADBW.INF
+                            type = bcmwlan bcmwlanAdapter
+                            bindform = "Bcmwlan1" yes yes container
+                            class = REG_MULTI_SZ "bcmwlanAdapter basic"
+                            InfOption = BCMWLAN
+#endif // defined(_RASPI_)
