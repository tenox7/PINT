#ntdiff PUBLIC/OAK/BIN/SOFTWARE.INI
=1 1 880
+#if defined(_RASPI_) && !defined(_NETIDW_SETUP_)
+                    1
+                        ServiceName = Bcmeth1
+                        Manufacturer = Microsoft
+                        Title = [1] Raspberry Pi Ethernet Adapter
+                        Description = Raspberry Pi Ethernet Adapter
+                        ProductName = Bcmeth
=1 876 1 8
+                        NetRules
+                            InfName = OEMNADBC.INF
+                            type = bcmeth bcmethAdapter
+                            bindform = "Bcmeth1" yes yes container
+                            class = REG_MULTI_SZ "bcmethAdapter basic"
+                            InfOption = BCMETH
+                    2
+                        ServiceName = Bcmwlan1
+                        Manufacturer = Microsoft
+                        Title = [2] Raspberry Pi Wireless Adapter
+                        Description = Raspberry Pi Wireless Adapter
+                        ProductName = Bcmwlan
=1 876 1 8
+                        NetRules
+                            InfName = OEMNADBW.INF
+                            type = bcmwlan bcmwlanAdapter
+                            bindform = "Bcmwlan1" yes yes container
+                            class = REG_MULTI_SZ "bcmwlanAdapter basic"
+                            InfOption = BCMWLAN
+#endif // defined(_RASPI_) && !defined(_NETIDW_SETUP_)
=1 881 365
+#if defined(_RASPI_)
+                    Taskman=taskman.exe /tasklist
+#endif // defined(_RASPI_)
=1 1246 162
+#if defined(_RASPI_)
+                    bcmsnd32.dll = Raspberry Pi Sound
+#endif
=1 1408 8
+#if defined(_RASPI_)
+                    //
+                    // The Raspberry Pi's sound driver (bcmsound.sys) and its multimedia driver,
+                    // as the Windows Sound System's sndsys32.dll is installed: wave, mixer, aux
+                    // and MIDI (its FM synthesizer); mmdrv.dll's devices are those of drivers
+                    // named for it (\Device\WaveOut0), which the port has none of.
+                    //
+                    wave=bcmsnd32.dll
+                    midi=bcmsnd32.dll
+                    aux=bcmsnd32.dll
+                    mixer=bcmsnd32.dll
+#else
=1 1416 3
+#endif
=1 1419 338
+#if defined(_RASPI_) && !defined(_NETIDW_SETUP_)
+                        //
+                        // The Server Manager extension of the FTP Server (OEMNSVFT.INF).
+                        //
+                        ftpsmx = ftpsmx.dll
+#endif // defined(_RASPI_) && !defined(_NETIDW_SETUP_)
=1 1757 5
+#if defined(_RASPI_)
+                    //
+                    // The setup of the MIDI Mapper (through which Media Player plays MIDI files):
+                    // that of the Raspberry Pi's FM synthesizer in MIDIMAP.CFG, which the build
+                    // makes from the Windows Sound System's (tools/midimap.pl).
+                    //
+                    Mapping Name=Raspberry Pi
+#else
=1 1762 1
+#endif
=1 1763 9
+#if defined(_RASPI_) && !defined(_NETIDW_SETUP_)
+                ncacn_nb_tcp0 = REG_DWORD 0x00000000
+#endif // defined(_RASPI_) && !defined(_NETIDW_SETUP_)
=1 1772 3
+#if defined(_RASPI_) && !defined(_NETIDW_SETUP_)
+                ncacn_ip_tcp=rpclts3.dll
+                ncadg_ip_udp=rpcdgs3.dll
+                ncacn_nb_tcp=rpclts5.dll
+#endif // defined(_RASPI_) && !defined(_NETIDW_SETUP_)
=1 1775 3
+#if defined(_RASPI_) && !defined(_NETIDW_SETUP_)
+                ncacn_ip_tcp=rpcltc3.dll
+                ncadg_ip_udp=rpcdgc3.dll
+                ncacn_nb_tcp=rpcltc5.dll
+            SecurityService
+                DefaultProvider = security.dll
+                10 = security.dll
+                DefaultAuthLevel = REG_DWORD 0x00000000
+        //
+        // The network products of the Raspberry Pi network install (the network
+        // block of SYSTEM.INI). The network control panel stores their bindings when
+        // the developer first run starts NCPABIND.INF (registry.ini).
+        //
+        Bcmeth
+            CurrentVersion
+                ServiceName = Bcmeth
+                RefCount = REG_DWORD 0x00000001
+                SoftwareType = driver
+                MajorVersion = REG_DWORD 0x00000003
+                MinorVersion = REG_DWORD 0x00000005
+                Title = Raspberry Pi Ethernet Adapter Driver
+                Description = Raspberry Pi Ethernet Adapter Driver
=1 876 1
+                NetRules
+                    InfName = OEMNADBC.INF
+                    type = bcmethSys ndisDriver bcmethDriver
+                    use = driver
+                    bindform = "BcmethSys" yes no container
+                    class = REG_MULTI_SZ "bcmethDriver basic"
+                    bindable = REG_MULTI_SZ "bcmethDriver bcmethAdapter non exclusive 100"
+                    InfOption = BCMETH
+        Bcmwlan
+            CurrentVersion
+                ServiceName = Bcmwlan
+                RefCount = REG_DWORD 0x00000001
+                SoftwareType = driver
+                MajorVersion = REG_DWORD 0x00000003
+                MinorVersion = REG_DWORD 0x00000005
+                Title = Raspberry Pi Wireless Adapter Driver
+                Description = Raspberry Pi Wireless Adapter Driver
=1 876 1
+                NetRules
+                    InfName = OEMNADBW.INF
+                    type = bcmwlanSys ndisDriver bcmwlanDriver
+                    use = driver
+                    bindform = "BcmwlanSys" yes no container
+                    class = REG_MULTI_SZ "bcmwlanDriver basic"
+                    bindable = REG_MULTI_SZ "bcmwlanDriver bcmwlanAdapter non exclusive 100"
+                    InfOption = BCMWLAN
+        Browser
+            CurrentVersion
+                ServiceName = Browser
+                RefCount = REG_DWORD 0x00000000
+                SoftwareType = service
+                MajorVersion = REG_DWORD 0x00000003
+                MinorVersion = REG_DWORD 0x00000005
+                Title = Computer Browser
+                Description = Microsoft Network Browser Service
=1 876 1
+                NetRules
+                    InfName = OEMNSVWK.INF
+                    InfOption = BROWSER
+        //
+        // The FTP Server (ftpsvc.dll, in tcpsvcs.exe) as OEMNSVFT.INF installs it (Network in
+        // Control Panel, Add Software, TCP/IP Protocol): its service is in SYSTEM.INI.
+        //
+        FTPSVC
+            CurrentVersion
+                ServiceName = FTPSVC
+                RefCount = REG_DWORD 0x00000000
+                SoftwareType = service
+                MajorVersion = REG_DWORD 0x00000003
+                MinorVersion = REG_DWORD 0x00000005
+                Title = FTP Server
+                Description = FTP Server
=1 876 1
+                NetRules
+                    InfName = OEMNSVFT.INF
+                    InfOption = FTPD
+        LanmanServer
+            CurrentVersion
+                ServiceName = LanmanServer
+                RefCount = REG_DWORD 0x00000000
+                SoftwareType = service
+                MajorVersion = REG_DWORD 0x00000003
+                MinorVersion = REG_DWORD 0x00000005
+                Title = Server
+                Description = Microsoft Windows Server Service
=1 876 1
+                NetRules
+                    InfName = OEMNSVSV.INF
+                    type = srv lmNetService lanmanServer
+                    class = REG_MULTI_SZ "lanmanServer lmNetService"
+                    use = service yes yes
+                    bindform = "LanmanServer" yes yes container
+                    InfOption = SRV
+        LanmanWorkstation
+            CurrentVersion
+                ServiceName = LanmanWorkstation
+                RefCount = REG_DWORD 0x00000000
+                SoftwareType = service
+                MajorVersion = REG_DWORD 0x00000003
+                MinorVersion = REG_DWORD 0x00000005
+                Title = Workstation
+                Description = Microsoft Windows Workstation Service
=1 876 1
+                NetRules
+                    InfName = OEMNSVWK.INF
+                    type = wksta lmNetService lanmanWorkstation
+                    class = REG_MULTI_SZ "lanmanWorkstation lmNetService"
+                    use = service yes yes
+                    bindform = "LanmanWorkstation" yes yes container
+                    InfOption = WKSTA
+        Ncpa
+            CurrentVersion
+                NtlanmanInfName = REG_EXPAND_SZ NTLANMAN.INF
+                NcpaShelInfName = REG_EXPAND_SZ NCPASHEL.INF
+                RawRules = REG_MULTI_SZ "(devClass ndisDriver basic no)"  \
+                                        "(devClass ndisTransport basic no)"  \
+                                        "(devClass netBiosTransport ndisTransport no)"  \
+                                        "(devClass lmNetService basic no)"  \
+                                        "(bindable ndisTransport ndisDriver non non 100)"  \
+                                        "(bindable lmNetService netBiosTransport non non 100)"
+                IDW = REG_DWORD 0x00000001
+                ReviewPrograms = REG_MULTI_SZ "NBINFO.INF"
+        NetBIOS
+            CurrentVersion
+                ServiceName = NetBIOS
+                RefCount = REG_DWORD 0x00000000
+                SoftwareType = service
+                MajorVersion = REG_DWORD 0x00000003
+                MinorVersion = REG_DWORD 0x00000005
+                Title = NetBIOS Interface
+                Description = Microsoft NetBIOS Transport Interface
=1 876 1
+                NetRules
+                    InfName = OEMNSVNB.INF
+                    type = netbios lmNetService
+                    use = service yes yes
+                    bindform = "Netbios" yes yes container
+                    InfOption = NETBIOS
+        NetBT
+            CurrentVersion
+                ServiceName = NetBT
+                RefCount = REG_DWORD 0x00000000
+                SoftwareType = transport
+                MajorVersion = REG_DWORD 0x00000003
+                MinorVersion = REG_DWORD 0x00000005
+                Hidden = REG_DWORD 0x00000001
+                Title = WINS Client(TCP/IP)
+                Description = NetBT System Driver
=1 876 1
+                NetRules
+                    InfName = OEMNXPTC.INF
+                    type = netbt netBiosTransport netbtTransport
+                    use = transport yes yes
+                    bindform = "NetBT" yes yes simple
+                    class = REG_MULTI_SZ "netbtTransport netBiosTransport"
+                    InfOption = NETBT
+        RPCLOCATOR
+            CurrentVersion
+                ServiceName = RPCLOCATOR
+                RefCount = REG_DWORD 0x00000000
+                SoftwareType = service
+                MajorVersion = REG_DWORD 0x00000003
+                MinorVersion = REG_DWORD 0x00000005
+                Title = RPC Configuration
+                Description = Remote Procedure Call Configuration
=1 876 1
+                NetRules
+                    InfName = OEMNSVRP.INF
+                    InfOption = RPCLOCATE
+        Tcpip
+            CurrentVersion
+                ServiceName = Tcpip
+                RefCount = REG_DWORD 0x00000000
+                SoftwareType = transport
+                MajorVersion = REG_DWORD 0x00000003
+                MinorVersion = REG_DWORD 0x00000005
+                Title = TCP/IP Protocol
+                Description = TCP/IP Protocol Driver
+                Review = REG_DWORD 0x00000001
=1 876 1
+                NetRules
+                    InfName = OEMNXPTC.INF
+                    type = tcpip tcpipTransport
+                    use = transport yes yes
+                    bindform = "Tcpip" yes yes container
+                    bindable = REG_MULTI_SZ "tcpipService tcpipTransport non exclusive 100"  \
+                                            "tcpipTransport ndisDriver non non 100"
+                    class = REG_MULTI_SZ "tcpipTransport basic"  \
+                                         "tcpipService basic yes"
+                    InfOption = TC
+#endif // defined(_RASPI_) && !defined(_NETIDW_SETUP_)
=1 1778 134
