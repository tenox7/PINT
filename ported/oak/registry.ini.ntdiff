#ntdiff ../nt35/PUBLIC/OAK/BIN/REGISTRY.INI
#crlf
=1 1 2
=1 4 8
+// The Raspberry Pi: no paging file, the shell of NT 4.0.                   //
=1 14 3
=1 30 2
+;  The ID the machine uses for its internal domain (WinNt product).
+;
=1 38 2
=1 29 3
+;  The name of the machine.
+;
+MachineName
+    RASPI
=1 29 3
+;  The account the Logon screen shows by default.
+;
+UserName
+    Administrator
=1 29 3
+;  Its password. winlogon.cmd then turns on AutoAdminLogon: from the third boot on, NT
+;  logs this account on by itself (Shift held down while it starts shows the Logon box).
+;
+Password
+    password
=1 29 3
+; The environment variables established at the beginning of each logon.
+;
+Environment
+    tmp = c:\tmp
=1 29 3
+; The time zone.
+;
=1 191 3
=1 229 6
=1 251 4
+;
+;  No ProductType: the SYSTEM hive holds it, and NT 4.0 takes any later write of it for
+;  tampering with the product type (a License Violation box).
+;
+;  The workgroup of the machine (a domain with a DomainId would make it a member).
+;
+Domain
+    WORKGROUP
=1 255 3
+;  Commands for the start of winlogon.cmd, after its first line, which makes Program
+;  Manager the shell: the shell of NT 4.0 is Explorer. With ! for its end: GUI setup ends
+;  with RUNONCE -r, which runs the commands of RunOnce before the first logon; NET USER
+;  gives the account the password above (with a network, winlogon.cmd only stores it for
+;  the logon).
+;  Then, as the setup of Peer Web Services does for its FTP service: the account of the
+;  anonymous user, a guest with no password (FTPUSER of PINT: NET USER /ADD wants the
+;  Workstation service, which is not running here), and (SVCSETUP, of the Internet
+;  services) the LSA secrets that hold that password, without which the service does not
+;  start.
+;  With a password, winlogon.cmd restarts at once, while the display boxes of this logon
+;  may still be open: so it says so and waits for a key, as it does without one.
+;
+InsertScript
+    ini winlogon.Shell = "Explorer.exe"
+    !runonce -r
+    !net user Administrator password
+    !%SystemRoot%\System32\inetsrv\ftpuser IUSR_RASPI
+    !%SystemRoot%\System32\inetsrv\svcsetup FtpSvc /add
+    !@echo Windows NT will now restart and log on as Administrator.
+    !@pause
